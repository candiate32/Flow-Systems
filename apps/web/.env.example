# Copy to .env.local. Everything prefixed VITE_ is shipped to the browser:
# only public values here. Never put the service_role / secret key in this file.

# Supabase project URL (local stack: http://127.0.0.1:54321).
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable (anon) key. Public; RLS protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key. Leave empty to skip the widget (local dev).
VITE_TURNSTILE_SITE_KEY=
# Each studio form's source key and WhatsApp fallback number live in its config:
# src/forms/configs/<slug>.ts (spec 003), not in env vars.

# Set to true on static hosts without SPA rewrites (GitHub Pages previews): routes become /#/admin.
VITE_HASH_ROUTER=
